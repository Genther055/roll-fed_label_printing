{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "includeFiles": ["samples/**", "core/**", "static/**", "index.html"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
