{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/*.py": {
      "includeFiles": "{samples/**,core/**,static/**,public/**,api/static/**,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/download/:match*",
      "destination": "/api/index.py"
    }
  ]
}
