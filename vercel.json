{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "includeFiles": "{samples/**,core/**,static/**,index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py?__path__=/api/:match*"
    },
    {
      "source": "/download/:match*",
      "destination": "/api/index.py?__path__=/download/:match*"
    }
  ]
}
